  "exceptions": {
    "invalid_auth": { "message": "The clock rejected the password." },
    "update_failed": { "message": "Cannot read from the clock: {error}" },
    "communication_error": { "message": "The clock did not accept the command: {error}" },
    "invalid_value": { "message": "Invalid value: {error}" },
    "not_possible_now": { "message": "Not possible right now: {error}" },
    "time_and_date_hidden": { "message": "Time and date cannot both be hidden (0 s)." }
